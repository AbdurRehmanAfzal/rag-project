# Nginx server block for abdurrehmanafzal.cloud
#
# Install path (Ubuntu): /etc/nginx/sites-available/abdurrehmanafzal.cloud
# Then: sudo ln -s /etc/nginx/sites-available/abdurrehmanafzal.cloud /etc/nginx/sites-enabled/
#
# This config assumes the repo lives at /var/www/rag-project (adjust REPO_PATH
# below to match wherever you cloned it) and that the FastAPI backend is
# running locally on 127.0.0.1:8000 via the systemd service in this folder.
#
# Run `sudo certbot --nginx -d abdurrehmanafzal.cloud -d www.abdurrehmanafzal.cloud`
# AFTER this config is enabled and reloaded once over plain HTTP — certbot
# will rewrite this file in place to add the HTTPS server block + redirect.

server {
    listen 80;
    listen [::]:80;
    server_name abdurrehmanafzal.cloud www.abdurrehmanafzal.cloud;

    # CHANGE THIS to the actual path where you cloned the repo on the VPS
    root /var/www/rag-project/frontend/dist;
    index index.html;

    # React SPA: serve the built static files, fall back to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Reverse proxy to the FastAPI backend (systemd service, port 8000)
    location /api/ {
        proxy_pass http://127.0.0.1:8000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Cache built JS/CSS assets aggressively (Vite fingerprints filenames)
    location /assets/ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
