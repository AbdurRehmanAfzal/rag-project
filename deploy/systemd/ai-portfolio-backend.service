[Unit]
Description=Abdur Rehman Afzal AI Portfolio - FastAPI backend
After=network.target

[Service]
# CHANGE THIS to the actual path where you cloned the repo on the VPS
WorkingDirectory=/var/www/rag-project
ExecStart=/var/www/rag-project/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
EnvironmentFile=/var/www/rag-project/.env
Restart=always
RestartSec=3
# CHANGE THIS to a non-root deploy user you created on the VPS
User=deploy
Group=deploy

[Install]
WantedBy=multi-user.target
