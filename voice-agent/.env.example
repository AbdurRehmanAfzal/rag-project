# Voice Property Concierge - environment template
# Copy to `.env` (never commit the real .env) and fill in your keys.

# --- Required API keys (all have free tiers / credits) -----------------------
# OpenAI - you already have this from the main portfolio.
OPENAI_API_KEY=sk-...

# Deepgram (Speech-to-Text) - sign up, $200 free credit. https://console.deepgram.com
DEEPGRAM_API_KEY=

# Cartesia (Text-to-Speech) - free tier. https://play.cartesia.ai  -> API keys
CARTESIA_API_KEY=

# --- Knowledge (RAG) ---------------------------------------------------------
# Which knowledge pack the agent answers from: "portfolio" (talk-to-my-CV,
# default) or "b1" (property listings, added later).
KB_SOURCE=portfolio
# Optional: override the pack's source file (defaults to ../knowledge_base.txt).
# KB_PATH=

# --- Optional tuning ---------------------------------------------------------
# Cost guard: max length of a single call in seconds (default 180 = 3 min).
MAX_SESSION_SECONDS=180

# LLM model (kept cheap by default).
OPENAI_MODEL=gpt-4o-mini

# Cartesia voice id (pick one in the Cartesia dashboard). Defaults to a stock voice.
# CARTESIA_VOICE_ID=71a7ad14-091c-4e8e-a314-022ece01c121
